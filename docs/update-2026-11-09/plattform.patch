+}
+
+/* Abprüfen: Akzentfarbe statt Gelb – kompakte Pille, fällt auf, ohne zu schreien */
+.pk-probe{flex-direction:row;align-items:center;gap:10px;padding:8px 8px 8px 16px;border-radius:99px;background:var(--x-acc);color:var(--x-on);box-shadow:0 6px 16px color-mix(in srgb,var(--x-acc) 30%,transparent);width:auto}
+.pk-probe b{font-size:.86rem;white-space:nowrap}.pk-probe small{font-size:.7rem;opacity:.8;white-space:nowrap}
+.pk-probe::after{content:"→";display:grid;place-items:center;width:26px;height:26px;border-radius:50%;background:color-mix(in srgb,var(--x-on) 18%,transparent);font-weight:800;font-size:.85rem;flex:none}
+.pk-probe:hover{filter:brightness(1.08)}
+.pk-tage{background:color-mix(in srgb,var(--x-acc) 12%,var(--lw-card,var(--x-card)));color:var(--x-acc)}
+.pk-fprobe{border:1.5px solid color-mix(in srgb,var(--x-acc) 45%,transparent);background:color-mix(in srgb,var(--x-acc) 7%,transparent)}
+.pk-fprobe:hover{background:color-mix(in srgb,var(--x-acc) 13%,transparent)}
+.pk-fprobe b{color:var(--x-acc)}
+@media (max-width:600px){
+  .pk-probe{padding:6px 6px 6px 14px;gap:8px}.pk-probe b{font-size:.82rem}.pk-probe small{font-size:.66rem}
+  .pk-probe::after{width:24px;height:24px}
+  .pk-klh .pk-probe{margin-left:52px;max-width:calc(100% - 52px);min-width:0}
+  .pk-probe small{display:none}
+}
+/* Quiz: Schaubild-Fragen nutzen die Farben der Lernseiten; „Zum Thema“ */
+.q-bild{--ink:var(--x-ink);--muted:var(--x-mut);--faint:var(--x-mut);--card:var(--x-card);--line:var(--x-line);--pale:var(--x-soft);--pale-2:var(--x-soft2);--primary:var(--fach,var(--x-acc));--primary-2:var(--fach,var(--x-acc));--on-primary:#fff;--axis:var(--x-mut);--axis2:var(--x-line);--grid:var(--x-line);--c1:var(--x-acc);--pos:var(--x-ok);--neg:var(--x-nok)}
+.q-bild svg{max-width:100%;height:auto;display:block;margin:0 auto}
+.q-thema{margin-left:auto}
+/* „Wichtig“: oft geprüfte Punkte · Hilfe in der leichten Klausurform */
+b.bdg-w{display:inline-block;font-size:.66rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:1px 7px;margin-right:7px;border-radius:99px;border:1px solid var(--x-warn);color:var(--x-warn);vertical-align:1px}
+.sw-wi.on i{background:var(--x-acc)}
+.q-hilfe{display:block;margin-top:8px;font-size:.84rem;color:var(--x-mut);font-style:italic}
+.zn-leg{font-size:.88rem;margin:4px 0 10px}
+/* Fehler im Rechenweg antippen */
+.q-weg{list-style:none;counter-reset:w;margin:8px 0 0;padding:0;display:grid;gap:6px}
+.q-weg li{counter-increment:w;display:flex;gap:10px;align-items:stretch}
+.q-weg li::before{content:counter(w);flex:none;width:26px;height:26px;margin-top:9px;border-radius:50%;display:grid;place-items:center;font-size:.8rem;font-weight:700;background:var(--x-soft);color:var(--x-mut)}
+.q-weg .q-opt{flex:1;text-align:left;font-variant-numeric:tabular-nums}
+/* Feed „Neu in Lernweh“ */
+/* Neuigkeiten: kleine Kachel oben rechts (links neben „?“), klappt kurz auf */
+.lw-kopf{position:relative}
+.lw-kopf .lw-gruss{padding-right:96px}
+.lw-neu{position:absolute;z-index:30;top:-8px;right:52px}
+.lw-neu-k{height:34px;padding:0 12px;border-radius:17px;border:1px solid var(--x-line);background:var(--x-card);color:var(--x-mut);font:600 .78rem/1 inherit;letter-spacing:.02em;display:inline-flex;align-items:center;gap:6px;cursor:pointer}
+.lw-neu-k:hover,.lw-neu.auf .lw-neu-k{color:var(--x-ink);border-color:var(--x-acc)}
+.lw-neu-k i{width:7px;height:7px;border-radius:50%;background:var(--x-acc)}
+.lw-neu-pop{position:absolute;top:42px;right:0;width:min(270px,calc(100vw - 32px));padding:12px 14px;border-radius:14px;border:1px solid var(--x-line);background:var(--x-card);box-shadow:0 10px 30px rgba(0,0,0,.12);
+  opacity:0;transform:translateY(-4px);pointer-events:none;transition:opacity .2s,transform .2s;font-size:.86rem}
+.lw-neu.auf .lw-neu-pop{opacity:1;transform:none;pointer-events:auto}
+.lw-neu-kopf{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px}
+.lw-neu-kopf small{color:var(--x-mut)}
+.lw-neu-pop b{display:block;line-height:1.3}
+.lw-neu-pop p{margin:4px 0 8px;color:var(--x-mut);line-height:1.45;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
+.lw-neu-alle{border:0;background:none;padding:0;color:var(--x-acc);font:600 .8rem/1 inherit;display:inline-flex;align-items:center;gap:4px;cursor:pointer}
+.lw-neu-alle svg{width:12px;height:12px}
+@media (max-width:600px){.lw-neu{top:52px;right:0}.lw-kopf .lw-gruss{padding-right:44px}.lw-kopf .lw-gruss p{padding-right:30px}}
+.feed-liste{list-style:none;margin:6px 0 0;padding:0;display:grid;gap:10px}
+.feed-liste li{padding:12px 14px;border-radius:12px;background:var(--x-soft)}
+.feed-liste li.ungelesen{box-shadow:inset 3px 0 0 var(--x-acc)}
+.feed-liste p{margin:4px 0 0;color:var(--x-ink);line-height:1.5}
+.feed-kopf{display:flex;gap:10px;align-items:center;margin-bottom:4px}
+.feed-kopf small{color:var(--x-mut)}
+.feed-art{font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.04em;padding:1px 8px;border-radius:99px;border:1px solid currentColor;color:var(--x-acc)}
+.feed-besser{color:var(--x-ok,var(--x-acc))}.feed-behoben{color:var(--x-warn)}
+/* Geist-Ansicht (Admin): fremden Lernstand nur ansehen */
+.geist-leiste{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:12px;flex-wrap:wrap;padding:8px max(16px,env(safe-area-inset-right,0px)) 8px max(16px,env(safe-area-inset-left,0px));background:var(--x-ink);color:var(--x-bg);font-size:.9rem}
+.geist-leiste b{letter-spacing:.04em;text-transform:uppercase;font-size:.75rem}
+.geist-leiste span{flex:1;min-width:0;opacity:.85}
+.geist-leiste button{font:inherit;font-size:.85rem;padding:4px 12px;border-radius:99px;border:1px solid currentColor;background:transparent;color:inherit;cursor:pointer}
+.lw-geist .lw-tour-knopf{top:calc(56px + env(safe-area-inset-top,0px))}
+.q-hilfe-k{margin-right:auto}
+div.q-hilfe{font-style:normal;color:var(--x-ink, inherit);border-left:3px solid var(--x-line, currentColor);padding:4px 10px;margin:8px 0}
+div.q-hilfe small{display:block;margin-top:4px;color:var(--x-mut);font-size:.78rem}
